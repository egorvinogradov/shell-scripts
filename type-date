#!/usr/bin/env python3
"""type-date: Types the current date (YYYY-MM-DD) into the active field without using the clipboard."""
import subprocess, sys
from datetime import datetime

def main():
    date_str = datetime.now().strftime("%Y-%m-%d")
    type_cmd = f'tell application "System Events" to keystroke "{date_str}"'
    result = subprocess.run(["osascript", "-e", type_cmd], capture_output=True, text=True, timeout=5)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or result.stdout.strip()}", file=sys.stderr)
        sys.exit(1)
    print(f"OK {date_str}")

if __name__ == "__main__":
    main()
