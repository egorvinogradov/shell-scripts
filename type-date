#!/usr/bin/env python3
"""type-date: Types the current date (YYYY-MM-DD) into the active field without using the clipboard.

HOW THE KEYBOARD SHORTCUT IS SET (macOS Shortcuts app, nothing in this repo binds the key):
  1. Copy this file to ~/.local/bin/type-date
  2. Shortcuts app > new shortcut > action "Run Shell Script" > script: python3 ~/.local/bin/type-date
     (shell zsh; leave input options alone; untick "Use as Quick Action" / "Receive What's On Screen")
  3. Shortcut details (the i button, top right) > Add Keyboard Shortcut > press Shift+Ctrl+Option+Cmd+D
  Needs Accessibility permission for the Shortcuts app (System Settings > Privacy & Security).
"""
import subprocess, sys
from datetime import datetime

def main():
    date_str = datetime.now().strftime("%Y-%m-%d")
    type_cmd = f'tell application "System Events" to keystroke "{date_str}"'
    result = subprocess.run(["osascript", "-e", type_cmd], capture_output=True, text=True, timeout=5)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or result.stdout.strip()}", file=sys.stderr)
        sys.exit(1)
    print(f"OK {date_str}")

if __name__ == "__main__":
    main()
