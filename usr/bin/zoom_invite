#!/bin/bash
# zoom_invite: copy the invite link of your Zoom personal room to the clipboard at once,
# then start that call in the background (Zoom takes ~45 s to wake up from cold).
# Room details live in ~/.config/zoom_invite/room (PMI=..., LINK=...), never in this repo.
# The background part clicks Start in the preview dialog and closes Zoom's popups
# ("Start Zoom AI", "Not hearing anything?", "Meeting info"). It needs Accessibility
# permission for the app running it (Terminal, Claude, ...).

set -u

CONF=${ZOOM_INVITE_CONF:-$HOME/.config/zoom_invite/room}
[ -r "$CONF" ] || { echo "zoom_invite: missing $CONF (needs PMI=... and LINK=...)" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CONF"

# One scripting call that says where Zoom is: call | preview | ready | none
state() {
    # System Events can stall for tens of seconds when Zoom is not running: ask pgrep first
    pgrep -x zoom.us >/dev/null || { echo none; return; }
    osascript <<'EOF' 2>/dev/null
tell application "System Events"
    if not (exists process "zoom.us") then return "none"
    tell process "zoom.us"
        if exists menu bar item "Meeting" of menu bar 1 then return "call"
        set names to name of every window
        repeat with n in names
            if (n as text) contains "Zoom Meeting" then return "preview"
        end repeat
        if names contains "Zoom Workplace" then return "ready"
    end tell
end tell
return "none"
EOF
}

# Background worker: get the call up, then tidy the popups. Gives up after ~3 minutes.
# The preview dialog and the popups are invisible to scripting, so they are clicked by position.
start_call() {
    open -g "zoommtg://zoom.us/start?confno=$PMI"
    for _ in $(seq 400); do
        case "$(state)" in
            call) break ;;
            preview)
                # Start button, bottom right of the "Always show this preview" dialog
                osascript <<'EOF' >/dev/null 2>&1
tell application "System Events" to tell process "zoom.us"
    repeat with w in windows
        if (name of w) contains "Zoom Meeting" then
            set {wx, wy} to position of w
            set {ww, wh} to size of w
            click at {wx + ww * 0.873, wy + wh * 0.930}
            exit repeat
        end if
    end repeat
end tell
EOF
                ;;
        esac
        sleep 0.4
    done
    [ "$(state)" = "call" ] || exit 1
    sleep 1.5
    osascript <<'EOF' >/dev/null 2>&1
tell application "System Events" to tell process "zoom.us"
    repeat with w in windows
        if (name of w) is "Zoom Meeting" then
            set {wx, wy} to position of w
            set {ww, wh} to size of w
            click at {wx + ww - 159, wy + 132}       -- "Start Zoom AI" popup: Close
            click at {wx + ww / 2 + 128, wy + 84}    -- "Not hearing anything?" popup: x
            exit repeat
        end if
    end repeat
    if exists window "Meeting info" then click (first button of window "Meeting info")
end tell
EOF
}

printf '%s' "$LINK" | pbcopy
echo "$LINK"

[ "$(state)" = "call" ] && exit 0   # already in a call

echo "zoom_invite: link copied. Starting the call in the background..." >&2
start_call >/dev/null 2>&1 &
disown
