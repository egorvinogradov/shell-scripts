#!/bin/bash
# caff [hours]: prevent sleep for N hours (default 6). Re-running resets the timer.

hours=${1:-6}
pid_file=/tmp/caff.pid

if [ -f "$pid_file" ]; then
    kill "$(cat "$pid_file")" 2>/dev/null
fi

nohup caffeinate -diu -t $((hours * 3600)) >/dev/null 2>&1 &
pid=$!
echo "$pid" > "$pid_file"

echo "caff: no-sleep for ${hours}h (pid $pid)"
